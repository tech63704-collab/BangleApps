{
  "id": "uvsense",
  "name": "UV Sense",
  "shortName": "UV Sense",
  "version": "0.04",
  "description": "UV index pushed by Gadgetbridge weather (no network requests from the watch). Shows current UV and today's hourly history; vibration length reflects the level.",
  "icon": "app.png",
  "tags": "weather,tool",
  "supports": [
    "BANGLEJS2"
  ],
  "dependencies": {
    "weather": "app"
  },
  "storage": [
    {
      "name": "uvsense.app.js",
      "url": "app.js"
    },
    {
      "name": "uvsense.img",
      "url": "app-icon.js",
      "evaluate": true
    }
  ],
  "data": [
    {
      "name": "uvsense.json"
    }
  ]
}