  "icon": "app.png",
  "tags": "weather,tool",
  "supports": [
    "BANGLEJS2"
  ],
  "dependencies": {
    "android": "app"
  },
  "storage": [
    {
      "name": "uvsense.app.js",
      "url": "app.js"
    },
    {
      "name": "uvsense.img",
      "url": "app-icon.js",
      "evaluate": true
    }
  ],
  "data": [
    {
      "name": "uvsense.json"
    }
  ]
}