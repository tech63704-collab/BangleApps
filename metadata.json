  "icon": "app.png",
  "tags": "weather,tool",
  "supports": [
    "BANGLEJS2"
  ],
  "dependencies": {
    "weather": "app"
  },
  "storage": [
    {
      "name": "uvsense.app.js",
      "url": "app.js"
    },
    {
      "name": "uvsense.boot.js",
      "url": "boot.js"
    },
    {
      "name": "uvsense.img",
      "url": "app-icon.js",
      "evaluate": true
    }
  ],
  "data": [
    {
      "name": "uvsense.json"
    }
  ]
}